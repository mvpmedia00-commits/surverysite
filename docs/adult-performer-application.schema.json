    "own_wardrobe_toys_props": { "type": "string", "enum": ["Yes", "No"] },
    "notes": { "type": "string" },
    "headshot_url": { "type": "string" },
    "full_body_front_url": { "type": "string" },
    "full_body_rear_url": { "type": "string" },
    "explicit_sample_urls": {
      "type": "array",
