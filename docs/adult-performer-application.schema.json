{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mvpstats.xyz/docs/adult-performer-application.schema.json",
  "title": "Adult performer application",
  "description": "JSON body posted by adult-performer-application.html. No database table or API route is provisioned yet. The page posts this object to the SUBMIT_ENDPOINT constant in that file.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "properties": { "pay_tier": { "enum": ["Tier 2", "Both"] } }, "required": ["pay_tier"] },
          { "properties": { "tier_choice": { "enum": ["Tier 2", "Both"] } }, "required": ["tier_choice"] }
        ]
      },
      "then": {
        "properties": {
          "consents": { "contains": { "const": "tier2-unprotected-sti" } }
        }
      }
    }
  ],
  "required": [
    "name",
    "age",
    "city",
    "instagram",
    "email",
    "whatsapp",
    "tier_choice",
    "proposed_rate",
    "audition_ack",
    "experience_level",
    "acts_performed",
    "sti_tested_last_6_months",
    "willing_to_test_before_booking",
    "soft_categories",
    "hard_categories",
    "explicit_paid_platform",
    "availability_types",
    "pay_tier",
    "travel_covered",
    "overnight_multiday",
    "own_wardrobe_toys_props",
    "notes",
    "headshot_url",
    "full_body_front_url",
    "full_body_rear_url",
    "explicit_sample_urls",
    "scene_video_link",
    "consents"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "age": { "type": "integer", "minimum": 18, "maximum": 120 },
    "city": { "type": "string", "minLength": 1 },
    "instagram": { "type": "string", "description": "Optional when at least one photo is included." },
    "email": { "type": "string", "description": "Optional when WhatsApp is included. Empty or a valid email." },
    "whatsapp": { "type": "string", "description": "Optional when email is included." },
    "experience_level": {
      "type": "string",
      "enum": ["None", "A few shoots", "Experienced", "Agency-represented"]
    },
    "acts_performed": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["Solo", "Toy", "GG", "BG", "Anal", "DP", "Group", "POV", "Strap-on", "Fetish/BDSM", "Other"]
      }
    },
    "sti_tested_last_6_months": { "type": "string", "enum": ["", "Yes", "No"] },
    "willing_to_test_before_booking": { "type": "string", "enum": ["", "Yes", "No"] },
    "soft_categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["Artistic nude", "Implied", "Lingerie", "Boudoir", "Bodypaint"]
      }
    },
    "hard_categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["Solo", "Toy", "GG", "BG", "Anal", "DP/Group", "POV", "Fetish"]
      }
    },
    "explicit_paid_platform": {
      "type": "string",
      "enum": ["", "Yes", "Soft only", "Unsure"]
    },
    "availability_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["Overnight", "All day", "After work"]
      },
      "description": "English stored values. Spanish labels are Toda la noche, Todo el día, and Después del trabajo."
    },
    "pay_tier": {
      "type": "string",
      "enum": ["", "Tier 1", "Tier 2", "Both"],
      "description": "Tier 1 is COP 300.000 (about US$75). Tier 2 is COP 1.500.000 (about US$500). Spanish shows Nivel 2 — $1.500.000 COP. Empty when tier_choice is Open to discussion or Propose my rate."
    },
    "audition_ack": {
      "type": "boolean",
      "const": true,
      "description": "True when the applicant confirms a paid 1-hour audition (COP 150.000, paid to the performer) is required before booking. Spanish: audición de 1 hora, $150.000 COP."
    },
    "tier_choice": {
      "type": "string",
      "enum": ["Tier 1", "Tier 2", "Both", "Open to discussion", "Propose my rate"],
      "description": "English stored value. Spanish shows Nivel 1, Nivel 2, Ambos, Abierto a conversar, and Propongo mi tarifa."
    },
    "proposed_rate": { "type": "string", "description": "Optional text. Used when tier_choice is Propose my rate." },
    "travel_covered": { "type": "string", "enum": ["", "Yes", "No"] },
    "overnight_multiday": { "type": "string", "enum": ["", "Yes", "No"] },
    "own_wardrobe_toys_props": { "type": "string", "enum": ["", "Yes", "No"] },
    "notes": { "type": "string" },
    "headshot_url": { "type": "string" },
    "full_body_front_url": { "type": "string" },
    "full_body_rear_url": { "type": "string" },
    "explicit_sample_urls": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scene_video_link": { "type": "string" },
    "consents": {
      "type": "array",
      "minItems": 7,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "18-plus",
          "adult-explicit-content",
          "voluntary",
          "can-decline",
          "comp-usage-release",
          "sti-disclosure",
          "contact",
          "tier2-unprotected-sti"
        ]
      },
      "description": "tier2-unprotected-sti is required when pay_tier is Tier 2 or Both. It is omitted for Tier 1."
    }
  }
}
