    "name",
    "age",
    "city",
    "instagram",
    "email",
    "phone",
    "experience_level",
    "acts_performed",
    "acts_wont_do",
    "sti_tested_last_6_months",
    "willing_to_test_before_booking",
    "hard_soft_limits",
    "soft_categories",
    "hard_categories",
    "explicit_paid_platform",
    "availability_days",
    "pay_tier",
    "travel_covered",
    "overnight_multiday",
    "own_wardrobe_toys_props",
    "notes",
    "headshot_url",
    "full_body_front_url",
    "full_body_rear_url",
    "explicit_sample_urls",
    "scene_video_link",
    "consents"
