{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "surverysite.vercel.app"
        }
      ],
      "destination": "https://mvpstats.xyz/$1",
      "permanent": true
    },
    {
      "source": "/artistic-nude-landing",
      "destination": "/artistic-nude-survey-en",
      "permanent": true
    },
    {
      "source": "/artistic-nude-survey",
      "destination": "/artistic-nude-survey-en",
      "permanent": true
    },
    {
      "source": "/artistic-nude-survey.html",
      "destination": "/artistic-nude-survey-en",
      "permanent": true
    },
    {
      "source": "/artists",
      "destination": "/artist-application",
      "permanent": false
    },
    {
      "source": "/artist",
      "destination": "/artist-application",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/adult-performer-application",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/adult-performer-application.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/adult-performer-application-es",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/adult-performer-application-es.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/adult-performer",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/adult-performer.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/performer-invites-dashboard",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/performer-invites-dashboard.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
